{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wealth-shown-to-scale/schema/wealth.schema.json",
  "title": "Wealth list (world or Germany)",
  "type": "object",
  "required": ["meta", "people"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "meta.schema.json" },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank", "country", "source_of_wealth", "is_family", "persons_named", "wealth"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "country": { "type": "string" },
          "source_of_wealth": { "type": "string" },
          "profile_url": { "type": "string", "format": "uri" },
          "is_family": {
            "type": "boolean",
            "description": "true when the source reports a family or a group of heirs rather than one person."
          },
          "persons_named": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Number of named persons behind a family entry, if the source states it; null = no reliable data."
          },
          "wealth": { "$ref": "value.schema.json" }
        }
      }
    }
  }
}
